# Copy to .env (git-ignored) and fill in. Never commit .env.
#   cp .env.example .env

# --- Profile 1 (add _2_, _3_, ... for more; numbering stops at the first gap) ---
STALKERHEK_PROFILE_1_NAME=my-portal
STALKERHEK_PROFILE_1_PORTAL_URL=http://portal.example.com/stalker_portal/server/load.php
STALKERHEK_PROFILE_1_MAC=00:1A:79:00:00:00
STALKERHEK_PROFILE_1_HLS_PORT=4600
STALKERHEK_PROFILE_1_PROXY_PORT=4800
# Optional: MODEL, SERIAL_NUMBER, DEVICE_ID, DEVICE_ID2, SIGNATURE, TIME_ZONE,
# USERNAME, PASSWORD, WATCHDOG_TIME, EPG_URL
#STALKERHEK_PROFILE_1_MODEL=MAG254
#STALKERHEK_PROFILE_1_SERIAL_NUMBER=
#STALKERHEK_PROFILE_1_DEVICE_ID=
#STALKERHEK_PROFILE_1_DEVICE_ID2=
#STALKERHEK_PROFILE_1_SIGNATURE=
#STALKERHEK_PROFILE_1_TIME_ZONE=UTC

# --- StbEmu replay identity (only if the portal needs it) ---
#STALKERHEK_STBEMU_REPLAY=1
#STALKERHEK_STBEMU_HW2=
#STALKERHEK_STBEMU_PREHASH=
#STALKERHEK_STBEMU_ADID=
#STALKERHEK_STBEMU_HWVER=1.7-BD-00

# --- Web UI / Xtream ---
#STALKERHEK_XTREAM_PASSWORD=
#STALKERHEK_DISABLE_AUTH=1
#STALKERHEK_ALLOW_REGISTER=1
#STALKERHEK_TRUSTED_SUBNETS=192.168.0.0/16
#STALKERHEK_RESTART_HOURS=24
